# ============================================
# Social Media Workflow - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# AI Services
# ============================================

# GitHub Models API (GPT-5)
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
GITHUB_MODEL=openai/gpt-5
GITHUB_ENDPOINT=https://models.github.ai/inference

# Hugging Face (for Flux AI image generation)
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# Tavily API (for trend research)
# Get your key from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ============================================
# Cloud Storage - Cloudflare R2
# ============================================

# Cloudflare R2 Credentials (S3-compatible storage)
# Get from Cloudflare Dashboard: https://dash.cloudflare.com/
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET=your_r2_bucket_name

# R2 Public URL (custom domain or r2.dev URL) - images always uploaded as post_image.png
R2_PUBLIC_URL=https://your-r2-public-url.r2.dev

# ============================================
# Social Media Platforms
# ============================================

# LinkedIn API
# Create app at: https://www.linkedin.com/developers/
# Required scopes: w_member_social, r_liteprofile
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_URN=urn:li:person:your_person_id

# Facebook API
# Create app at: https://developers.facebook.com/
# Required permissions: pages_manage_posts, pages_read_engagement
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# Instagram API (via Facebook Graph API)
# Use Facebook Developer Console: https://developers.facebook.com/
# Required permissions: instagram_basic, instagram_content_publish
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_USER_ID=your_instagram_user_id

# ============================================
# Authentication
# ============================================

# Login username
AUTH_USERNAME=admin

# Password hash (bcrypt). Generate with:
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-password-here'))"
AUTH_PASSWORD_HASH=

# TOTP secret for 2FA (base32). Leave empty for first-time setup.
# On first login the app prints the secret to the console — copy it here and restart.
TOTP_SECRET=

# Session signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Email (Gmail SMTP for password reset)
# Generate app password at: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_gmail@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password
ADMIN_EMAIL=your_email@gmail.com

# ============================================
# Optional Configuration
# ============================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Image generation settings
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024

# Rate limiting delays (seconds)
RATE_LIMIT_DELAY=2
